# Project outputs / build
Outputs/
Bin/
temp_dir/
*.o
*.out
*.exe
*.a
*.so
*.dylib

# Python — **/ means "at any depth" (any folder in the repo)
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg
**/.venv/
**/venv/
**/env/
**/ENV/

# macOS — can appear in any directory
**/.DS_Store
.AppleDouble
.LSOverride
**/._*

# Linux
*~
.nfs*

# Editors / IDEs — can appear in any directory
**/.vscode/
**/.idea/
*.swp
*.swo
*~.nib
.project
.classpath
.settings/

# Cursor local state (keep shared rules if you add them later)
**/.cursor/

# Env / secrets
**/.env
.env.*
!.env.example

# Logs / temp
*.log
*.tmp
*.temp
**/.cache/
